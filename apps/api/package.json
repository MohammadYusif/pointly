{
  "name": "@pointly/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/presentation/http/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/presentation/http/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.705.0",
    "@aws-sdk/lib-dynamodb": "3.705.0",
    "@aws-sdk/client-secrets-manager": "3.705.0",
    "@aws-sdk/client-sqs": "3.705.0",
    "@aws-sdk/client-sns": "3.705.0",
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.1",
    "@fastify/rate-limit": "10.1.1",
    "@fastify/jwt": "9.0.1",
    "fastify": "5.2.0",
    "zod": "3.24.1",
    "axios": "1.7.9",
    "pino": "9.6.0",
    "pino-pretty": "13.0.0",
    "ulid": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@biomejs/biome": "1.9.4",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "@vitest/coverage-v8": "2.1.8",
    "tsc-alias": "1.8.10",
    "@types/aws-lambda": "8.10.145"
  }
}
