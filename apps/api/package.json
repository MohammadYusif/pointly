{
  "name": "@pointly/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/presentation/http/server.ts",
    "build": "tsc && tsc-alias",
    "build:lambda": "esbuild src/lambda.ts --bundle --platform=node --target=node20 --outfile=dist/lambda/index.js --external:@aws-sdk/* --minify",
    "build:lambda:decay": "esbuild src/scheduled-decay.ts --bundle --platform=node --target=node20 --outfile=dist/lambda-decay/index.js --external:@aws-sdk/* --minify",
    "build:lambda:tier-reset": "esbuild src/scheduled-tier-reset.ts --bundle --platform=node --target=node20 --outfile=dist/lambda-tier-reset/index.js --external:@aws-sdk/* --minify",
    "build:lambda:all": "pnpm build:lambda && pnpm build:lambda:decay && pnpm build:lambda:tier-reset",
    "start": "node dist/presentation/http/server.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1000.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.1013.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1013.0",
    "@fastify/aws-lambda": "^6.4.0",
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.1",
    "@fastify/jwt": "9.0.1",
    "@fastify/rate-limit": "10.1.1",
    "axios": "1.13.5",
    "fastify": "5.7.2",
    "fastify-plugin": "^5.1.0",
    "jwks-rsa": "^3.2.2",
    "pino": "9.6.0",
    "pino-pretty": "13.0.0",
    "ulid": "2.3.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/aws-lambda": "8.10.145",
    "@types/node": "22.10.5",
    "@vitest/coverage-v8": "2.1.9",
    "esbuild": "^0.27.2",
    "tsc-alias": "1.8.10",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.9"
  }
}
