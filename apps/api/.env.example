# Environment
NODE_ENV=development
ENVIRONMENT=dev

# AWS Region
AWS_REGION=me-south-1

# DynamoDB Tables
USER_LEDGER_TABLE=pointly-user-ledger-dev
TRANSACTION_TABLE=pointly-transactions-dev
IDEMPOTENCY_TABLE=pointly-idempotency-dev
QR_NONCE_TABLE=pointly-qr-nonce-dev
PENDING_CONSENTS_TABLE=pointly-pending-consents-dev
SMS_QUOTA_TABLE=pointly-sms-quota-dev
WALLET_PASSES_TABLE=pointly-wallet-passes-dev

# SQS
SMS_QUEUE_URL=https://sqs.me-south-1.amazonaws.com/123456789012/pointly-sms-queue-dev

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Cognito (Optional - for production)
# MERCHANT_USER_POOL_ID=me-south-1_xxxxxxxxx
# MERCHANT_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# CUSTOMER_USER_POOL_ID=me-south-1_xxxxxxxxx
# CUSTOMER_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Local Development (DynamoDB Local)
DYNAMODB_ENDPOINT=http://localhost:8000

# AWS SDK
AWS_NODEJS_CONNECTION_REUSE_ENABLED=1
