{
  "name": "pointly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "infra:deploy": "pnpm --filter @pointly/infrastructure deploy",
    "infra:destroy": "pnpm --filter @pointly/infrastructure destroy",
    "seed": "cd apps/api && node ../../scripts/seed-data.mjs",
    "seed:clean": "cd apps/api && node ../../scripts/seed-data.mjs --clean",
    "dev:landing": "turbo run dev --filter=@pointly/landing"
  },
  "pnpm": {
    "overrides": {
      "@next/swc-win32-x64-msvc": "15.5.11",
      "@next/swc-darwin-arm64": "15.5.11",
      "@next/swc-darwin-x64": "15.5.11",
      "@next/swc-linux-x64-gnu": "15.5.11",
      "@next/swc-linux-x64-musl": "15.5.11",
      "@next/swc-linux-arm64-gnu": "15.5.11",
      "@next/swc-linux-arm64-musl": "15.5.11",
      "fast-xml-parser": ">=5.5.6",
      "minimatch": ">=9.0.7",
      "rollup": ">=4.59.0",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "node-forge": ">=1.4.0",
      "picomatch": ">=2.3.2",
      "fast-jwt": ">=6.1.0"
    },
    "ignoredBuiltDependencies": ["@biomejs/biome", "core-js", "esbuild", "sharp"]
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.992.0",
    "@aws-sdk/client-dynamodb": "^3.992.0",
    "@aws-sdk/lib-dynamodb": "^3.992.0",
    "@biomejs/biome": "1.9.4",
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  }
}
