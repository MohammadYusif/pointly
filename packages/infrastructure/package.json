{
  "name": "@pointly/infrastructure",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all --require-approval never",
    "deploy:dev": "cdk deploy --all --require-approval never --context environment=dev",
    "deploy:prod": "cdk deploy --all --require-approval never --context environment=prod",
    "destroy": "cdk destroy --all",
    "bootstrap": "cdk bootstrap",
    "lint": "biome check .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/source-map-support": "^0.5.10",
    "@biomejs/biome": "1.9.4",
    "typescript": "5.7.2",
    "aws-cdk": "^2.170.0"
  }
}
