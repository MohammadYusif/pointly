  "terms": {
    "title": "شروط الاستخدام",
    "lastUpdated": "آخر تحديث: مارس 2026",
    "intro": "باستخدامك لـ Pointly، فإنك توافق على الشروط التالية.",
    "section1Title": "1. برنامج الولاء",
    "section1Body": "تشغّل Pointly منصة مكافآت الولاء. تُكسب النقاط من خلال المشتريات لدى التجار المشاركين ويمكن استبدالها وفقاً لقواعد كل تاجر. لا قيمة نقدية للنقاط خارج المنصة.",
    "section2Title": "2. الحساب",
    "section2Body": "أنت مسؤول عن الحفاظ على أمان حسابك. رقم هاتفك هو معرّفك الفريد. يجب أن يكون عمرك 13 سنة أو أكثر للتسجيل.",
    "section3Title": "3. النقاط والمكافآت",
    "section3Body": "تُضاف النقاط وفق تقدير التجار. تحتفظ Pointly بحق تصحيح أرصدة النقاط في حالة الأخطاء. قد تنتهي صلاحية النقاط غير المستخدمة وفق سياسة كل تاجر.",
    "section4Title": "4. التغييرات",
    "section4Body": "قد نحدّث هذه الشروط في أي وقت. استمرارك في استخدام المنصة يُعدّ قبولاً للشروط المحدّثة.",
    "section5Title": "5. التواصل",
    "section5Body": "للاستفسارات، تواصل معنا على support@pointly.sa."
  },
  "privacy": {
    "title": "سياسة الخصوصية",
    "lastUpdated": "آخر تحديث: مارس 2026",
    "intro": "تلتزم Pointly بحماية معلوماتك الشخصية.",
    "section1Title": "1. المعلومات التي نجمعها",
    "section1Body": "نجمع رقم هاتفك واسمك وتاريخ ميلادك عند التسجيل. كما نجمع بيانات المعاملات كالمشتريات واستبدال النقاط.",
    "section2Title": "2. كيفية استخدام بياناتك",
    "section2Body": "تُستخدم بياناتك لتشغيل برنامج الولاء وإضافة النقاط واستبدالها وتزويد التجار بتحليلات مجمّعة. لا نبيع بياناتك الشخصية.",
    "section3Title": "3. مشاركة البيانات",
    "section3Body": "تُشارك سجل معاملاتك مع التجار الذين تتعامل معهم. لا يُكشف عن رقم هاتفك للتجار إلا بقدر ما هو ضروري للتحقق.",
    "section4Title": "4. الأمان",
    "section4Body": "نستخدم معايير أمان عالية تشمل التشفير والمصادقة الآمنة (OTP) لحماية حسابك.",
    "section5Title": "5. حقوقك",
    "section5Body": "يمكنك طلب حذف حسابك وبياناتك الشخصية بالتواصل مع support@pointly.sa.",
    "section6Title": "6. التواصل",
    "section6Body": "للاستفسارات المتعلقة بالخصوصية، راسلنا على privacy@pointly.sa."
  }
